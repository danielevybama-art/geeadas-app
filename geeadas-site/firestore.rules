rules_version = '2';
// Règles de sécurité — GEEAD Abidjan Sud v2
// utilisateurs/{uid} : { nom, titre, niveau: "regional"|"local", celluleId, acces: "complet"|"lecture", actif }
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function aProfil() { return connecte() && exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)); }
    function profil() { return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data; }
    function actif() { return aProfil() && profil().get('actif', true) == true; }
    function regional() { return actif() && profil().niveau == 'regional'; }
    function local() { return actif() && profil().niveau == 'local'; }
    function gestion() { return actif() && profil().get('acces', 'complet') != 'lecture'; }
    function maCellule() { return profil().celluleId; }
    function deMaCellule() { return local() && resource.data.celluleId == maCellule(); }
    function versMaCellule() { return local() && request.resource.data.celluleId == maCellule(); }

    // Comptes : le bureau régional gère tout ; un local voit son propre profil et le bureau de sa cellule
    match /utilisateurs/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || regional() || deMaCellule());
      allow write: if regional() && gestion();
      // Première connexion Google : administrateur initial, ou personne invitée par le bureau régional
      allow create: if connecte() && request.auth.uid == uid && request.auth.token.email_verified == true && (
        (request.auth.token.email == 'danielevybama@gmail.com' && request.resource.data.niveau == 'regional')
        || (exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
            && request.resource.data.niveau == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.niveau
            && request.resource.data.get('celluleId', '') == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.get('celluleId', '')
            && request.resource.data.get('acces', 'complet') == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.get('acces', 'complet'))
      );
    }

    // Invitations (clé = adresse e-mail en minuscules)
    match /invitations/{email} {
      allow read, delete: if connecte() && request.auth.token.email == email;
      allow read, write: if regional() && gestion();
    }

    // Cellules : lisibles publiquement (formulaire d'inscription), gérées par le régional
    match /cellules/{id} {
      allow read: if true;
      allow write: if regional() && gestion();
    }

    // Membres
    match /membres/{id} {
      allow read: if regional() || deMaCellule();
      allow create: if gestion() && (regional() || versMaCellule());
      allow update: if gestion() && (regional() || deMaCellule());   // un local peut transférer un membre hors de sa cellule
      allow delete: if regional() && gestion();
    }

    // Notes de suivi
    match /suivis/{id} {
      allow read: if regional() || deMaCellule();
      allow create: if gestion() && (regional() || versMaCellule());
      allow update, delete: if regional() && gestion();
    }

    // Inscriptions publiques : dépôt libre, lecture réservée
    match /inscriptions/{id} {
      allow create: if request.resource.data.keys().hasAll(['nom','prenoms','telephone','consentement'])
                    && request.resource.data.consentement == true
                    && request.resource.data.nom is string && request.resource.data.nom.size() < 80
                    && request.resource.data.get('photo', '').size() < 150000;
      allow read: if regional() || deMaCellule();
      allow delete: if gestion() && (regional() || deMaCellule());
      allow update: if false;
    }

    // Annonces du bureau régional
    match /annonces/{id} {
      allow read: if actif();
      allow write: if regional() && gestion();
    }

    // Journal d'activité : tout responsable écrit, seul le régional lit
    match /journal/{id} {
      allow create: if actif();
      allow read: if regional();
      allow update, delete: if false;
    }

    // Compteur des identifiants et paramètres
    match /meta/compteur { allow read, write: if gestion(); }
    match /meta/parametres { allow read: if actif(); allow write: if regional() && gestion(); }
  }
}
